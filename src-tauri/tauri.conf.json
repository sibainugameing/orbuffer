{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrBuffer",
  "version": "0.1.0",
  "identifier": "com.sibainugameing.orbuffer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OrBuffer",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
